# Docker Compose Environment Configuration
# Copy this file to .env and configure with your API keys

# ============================================================
# Vision AI Provider Configuration
# ============================================================

# Choose your vision provider: 'hermes' (default), 'openai', 'nvidia', 'ollama', or 'mock'
VISION_PROVIDER=openai

# OpenAI Configuration (if using VISION_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4-vision-preview

# OpenAI Configuration (if using VISION_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-4-vision-preview

# ============================================================
# Database Configuration
# ============================================================

DB_USER=pantry
DB_PASSWORD=pantry_secure_pass
DB_NAME=pantry_db

# ============================================================
# Application Configuration
# ============================================================

LOG_LEVEL=INFO
DEBUG=false

# ============================================================
# Notes
# ============================================================
#
# 1. Get OpenAI API key: https://platform.openai.com/api-keys
# 2. Point HERMES_VISION_URL at your agent's OpenAI-compatible vision endpoint (or leave unset for OpenAI)
# 3. Only one provider key is required (based on VISION_PROVIDER)
# 4. Change DB_PASSWORD for production deployments
# 5. Set DEBUG=false for production
#
